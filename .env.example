# ============================================================================
#  复制本文件为 .env 后再填写真实值：  cp .env.example .env   （Windows: copy .env.example .env）
#  .env 不要提交到 git（已在 .gitignore 中忽略）
# ============================================================================

# ---------- DeepSeek（兼容 OpenAI 格式） ----------
# 到 https://platform.deepseek.com/ 申请，格式形如 sk-xxxxxxxx
DEEPSEEK_API_KEY=sk-xxxxxxxx
# 一般不用改；如需换代理或使用自建网关再修改
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# deepseek-chat（默认，响应快）或 deepseek-reasoner（带思维链）
DEEPSEEK_MODEL=deepseek-chat
AI_TEMPERATURE=0.3

# ---------- AI 视角（prismarine-viewer，必须用独立端口） ----------
# 依赖说明：prismarine-viewer 需要 canvas，本项目通过 npm alias 用 @napi-rs/canvas 提供
#          （package.json 里写作 "canvas": "npm:@napi-rs/canvas@^1"），零编译，
#          Windows 无需安装 VS Build Tools / Python。
VIEWER_ENABLED=1          # 0 = 完全关闭，不监听任何额外端口
VIEWER_PORT=3001          # 不能与 PORT(3000) / MC_PORT 冲突
VIEWER_HOST=localhost     # 只用于生成访问地址（0.0.0.0/:: 会自动规范化为 localhost）
VIEWER_FIRST_PERSON=1     # 1 = 第一人称，0 = 第三人称环绕
VIEWER_VIEW_DISTANCE=8    # 渲染距离（格），越大越吃 CPU
VIEWER_PUBLIC_URL=        # 显式指定 iframe 地址（留空 = http://${VIEWER_HOST}:${VIEWER_PORT}）
#
# 注意：prismarine-viewer 内部固定 http.listen(port)（没有 host 参数），
#      实际会监听 0.0.0.0；如需仅本机访问，请用防火墙 / 反向代理限制。

# ---------- Agent 人格（决定说话语气，不影响能力） ----------
# worker   = 幽默的赛博打工人（默认）
# tsundere = 傲娇的生存大师
# chunibyo = 极其中二的冒险家
AGENT_PERSONA=worker

# ---------- Minecraft 服务器（离线模式） ----------
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=AIAgent
# 留空表示自动探测服务端版本；已知版本可填 1.20.4 之类
MC_VERSION=
